}

function weekRij(w){
  var namen = NL ? ["ma","di","wo","do","vr","za","zo"] : ["mon","tue","wed","thu","fri","sat","sun"];
  var d = (w && w.dagelijks) || [];
  var uit = "<div class='week'>";
  for(var i = 0; i < 7; i++){
    var v = d[i];
    var cls = v === true ? "bol vol" : (v ? "bol iets" : "bol");
    var teken = v === true ? "✓" : (v ? "·" : "");
    uit += "<div class='dag'><div class='"+cls+"'>"+teken+"</div><small>"+namen[i]+"</small></div>";
  }
  return uit + "</div>";
}

// Vergelijken met vorige week, maar zonder oordeel: geen "helaas", geen pijl omlaag in het rood.
// Een maatje dat de app namens de app teleurgesteld ziet doen, gaat de leerling niet aanmoedigen.
function vergelijk(nu, vorig){
  if(!vorig || (!vorig.dagen && !vorig.lessen)) return "";
  if(nu.dagen > vorig.dagen) return t("Meer dagen dan vorige week ("+vorig.dagen+"). Zeg er iets van.",
                                      "More days than last week ("+vorig.dagen+"). Say something about it.");
  if(nu.dagen === vorig.dagen) return t("Net zoveel dagen als vorige week ("+vorig.dagen+"). Volhouden is het hele punt.",
                                        "Same number of days as last week ("+vorig.dagen+"). Keeping it up is the whole point.");
  return t("Wat minder dan vorige week ("+vorig.dagen+"). Een drukke week overkomt iedereen.",
           "A bit less than last week ("+vorig.dagen+"). Everyone has a busy week.");
}

function toon(d){
  var naam = esc(d.leerling || t("Iemand","Someone"));
  var w = d.week || {dagen:0, lessen:0, dagelijks:[]};
  document.getElementById("badge").textContent = t("meekijken","following along");
  document.getElementById("inhoud").innerHTML =
    "<div class='card'>"+
      "<span class='kicker'>"+t("De week van","This week for")+" "+naam+"</span>"+
      chispa()+
      "<p class='big' style='text-align:center; margin:6px 0'>"+w.dagen+"/7 "+
        t("dagen doel gehaald","days on goal")+"</p>"+
      weekRij(w)+
      "<p class='muted' style='text-align:center; margin:10px 0 0'>"+esc(vergelijk(w, d.vorige))+"</p>"+
      "<div class='statgrid'>"+
        "<div class='stat'><b>🔥 "+(d.streak || 0)+"</b><span>"+t("dagen op rij","day streak")+"</span></div>"+
        "<div class='stat'><b>"+(w.lessen || 0)+"</b><span>"+t("lessen deze week","sessions this week")+"</span></div>"+
        "<div class='stat'><b>"+(d.woorden || 0)+"</b><span>"+t("woorden geleerd","words learned")+"</span></div>"+
        "<div class='stat'><b>"+(d.vorige ? d.vorige.dagen : 0)+"/7</b><span>"+t("vorige week","last week")+"</span></div>"+
      "</div>"+
      "<div class='uitleg'>"+t(
        "Je hoeft hier niets te doen. Deze pagina blijft werken, dus je kunt hem bewaren en er af en toe even naar kijken. Het helpt het meest als je er gewoon iets over zegt als je "+naam+" spreekt.",
        "There's nothing for you to do here. This page keeps working, so you can bookmark it and check in now and then. It helps most if you simply mention it next time you speak to "+naam+".")+"</div>"+
      "<p class='muted' style='margin:10px 0 0'>"+t(
        "Je ziet alleen deze cijfers: geen fouten, geen antwoorden, geen persoonlijke gegevens.",
        "You only see these numbers: no mistakes, no answers, no personal details.")+"</p>"+
    "</div>"+
    "<p class='voet'>"+t("Zelf ook eens kijken? ","Curious yourself? ")+
      "<a href='https://vamos.stefanwobben.nl/'>¡Vamos!</a></p>";
}

(function(){
